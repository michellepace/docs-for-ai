{
    // General editor settings
    "window.commandCenter": true,   // command + file search in the title bar
    "editor.colorDecorators": true, // colour swatches next to hex/rgb values

    // Hide generated dirs from Explorer, search & quick-open
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true
    },

    // 🐍 UV PYTHON ENVIRONMENT
    // `uv sync` creates .venv/ → IDE auto-detects the interpreter below.
    // uv convention: don't activate the venv — run commands via `uv run <cmd>`
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false,

    // 🐍 Ruff: Python lint & format (rules in pyproject.toml)
    "ruff.nativeServer": "on", // for speed
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    // 🧩 Even Better TOML: format .toml on save
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },

    // 📝 Markdownlint: autofix on save (rules in .markdownlint-cli2.yaml)
    "[markdown]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    }
}
