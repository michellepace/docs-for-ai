{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(claude mcp get *)",
      "Bash(claude mcp list)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(git log *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(pre-commit run *)",
      "Bash(pwd)",
      "Bash(pyright)",
      "Bash(ruff check *)",
      "Bash(ruff format)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(uv *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.envrc)"
    ]
  },
  "extraKnownMarketplaces": {
    "my-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "michellepace/my-claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "git-utils@my-claude-marketplace": true
  }
}
